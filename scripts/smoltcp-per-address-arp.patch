+
+    /// Silence after asking about one neighbour must not stop the stack asking
+    /// about another. With a cache-wide silence, a DNS lookup that has to
+    /// resolve the gateway holds back the resolution of a server on the same
+    /// link for a whole second.
+    #[test]
+    fn test_hush_is_per_address() {
+        let mut cache = Cache::new();
+
+        cache.limit_rate(MOCK_IP_ADDR_1.into(), Instant::from_millis(0));
+        assert_eq!(
+            cache.lookup(&MOCK_IP_ADDR_2.into(), Instant::from_millis(100)),
+            Answer::NotFound
+        );
+    }
+
+    /// Asking about another neighbor must not lift the silence on the first:
+    /// alternating between two unresolved addresses would otherwise send a
+    /// request on every lookup.
+    #[test]
+    fn test_hush_outlives_asking_about_another() {
+        let mut cache = Cache::new();
+
+        cache.limit_rate(MOCK_IP_ADDR_1.into(), Instant::from_millis(0));
+        cache.limit_rate(MOCK_IP_ADDR_2.into(), Instant::from_millis(100));
+        assert_eq!(
+            cache.lookup(&MOCK_IP_ADDR_1.into(), Instant::from_millis(200)),
+            Answer::RateLimited
+        );
+    }
+
+    /// With more neighbors pending than there is room to remember, every
+    /// unknown neighbor waits, as it did before silence was per address.
+    #[cfg(feature = "proto-ipv4")]
+    #[test]
+    fn test_hush_everyone_when_full() {
+        use crate::wire::Ipv4Address;
