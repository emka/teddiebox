/target
/tools/xtensa-linkcheck/target
/firmware/target
/.direnv

# The published `mbedtls-rs-sys`, with one version bound widened. Fetched and
# patched by scripts/vendor-mbedtls-rs-sys.sh rather than committed; see the
# comment beside the `[patch.crates-io]` entry in firmware/Cargo.toml.
/firmware/vendor/

# Bench credentials. `.envrc` is tracked; this is where the SLIX privacy
# password lives so it stays out of the history.
/.envrc.local

# `nix build` output symlinks.
/result
/result-*

# Generated audio, except the committed fixtures — those are the evidence
# base for every format claim in the parser and belong in the repo.
*.taf
*.wav
!/crates/teddiebox-taf/tests/data/*.taf

# Background agent worktrees. These are git repositories of their own and
# have no business in this history.
/.claude/worktrees/
