/target
/tools/xtensa-linkcheck/target
/firmware/target
/.direnv

# Patched copies of published crates (mbedtls-rs, mbedtls-rs-sys, smoltcp).
# Fetched and patched by the scripts/vendor-*.sh scripts rather than
# committed; see the `[patch.crates-io]` entries in firmware/Cargo.toml.
/firmware/vendor/

# Local settings and secrets, such as the SLIX privacy password. `.envrc` is
# tracked; this file keeps them out of the history.
/.envrc.local

# `nix build` output symlinks.
/result
/result-*

# Generated audio, except the committed fixtures — those are the evidence
# base for every format claim in the parser and belong in the repo.
*.taf
*.wav
!/crates/teddiebox-taf/tests/data/*.taf

# Background agent worktrees. These are git repositories of their own and
# have no business in this history.
/.claude/worktrees/

# cargo-mutants output, a report rather than a deliverable; see `just mutants`.
/mutants.out/
/mutants.out.old/
